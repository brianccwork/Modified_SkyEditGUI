Option Strict On
Option Explicit On

Imports System.IO

Friend Enum FigureEditorKind
    Unsupported
    Skylanders
    Vehicles
    Crystals
    Traps
End Enum

'Header-only display metadata. It never decrypts data, enables a writer, or touches
'legacy form controls. Matching editors independently validate the save data before enabling writes.
Friend NotInheritable Class ScannedFigureInfo
    Friend ReadOnly Property FigureName As String
    Friend ReadOnly Property GameName As String
    Friend ReadOnly Property Editor As FigureEditorKind
    Friend ReadOnly Property IsKnown As Boolean
    Friend ReadOnly Property IsBottomHalf As Boolean

    Friend Sub New(bytes As Byte())
        If bytes Is Nothing OrElse bytes.Length <> 1024 Then Throw New InvalidDataException("Read a complete figure first.")
        Dim id As Integer = CInt(bytes(16)) Or (CInt(bytes(17)) << 8)
        Dim variantId As Integer = CInt(bytes(28)) Or (CInt(bytes(29)) << 8)
        IsBottomHalf = IsBottomId(id)
        If id >= 680 AndAlso id <= 689 Then
            Dim element As String = {"Magic", "Water", "Air", "Undead", "Tech", "Fire", "Earth", "Life", "Dark", "Light"}(id - 680)
            FigureName = EditorArtworkCatalog.CrystalName(id, variantId, element & " Crystal")
            GameName = "Imaginators Crystals"
            Editor = FigureEditorKind.Crystals
            IsKnown = True
            Return
        End If
        If id >= 210 AndAlso id <= 220 Then
            FigureName = TrapCatalog.TrapName(id, variantId)
            GameName = "Traps"
            Editor = FigureEditorKind.Traps
            IsKnown = True
            Return
        End If
        Dim entry As String = Nothing
        If Not catalog.TryGetValue(id.ToString() & ":" & variantId.ToString(), entry) Then
            FigureName = "Unknown figure"
            GameName = String.Empty
            Return
        End If
        Dim parts As String() = entry.Split("|"c)
        GameName = parts(0)
        FigureName = parts(1)
        IsKnown = True
        Select Case GameName
            Case "Vehicles" : Editor = FigureEditorKind.Vehicles
            Case "Traps" : Editor = FigureEditorKind.Traps
            Case "Imaginators Crystals" : Editor = FigureEditorKind.Unsupported
            Case "Spyro's Adventure", "Giants", "Swap Force", "Trap Team", "SuperChargers", "Imaginators"
                Editor = FigureEditorKind.Skylanders
        End Select
    End Sub

    Friend Function Matches(editorKind As FigureEditorKind) As Boolean
        Return IsKnown AndAlso Not IsBottomHalf AndAlso Editor <> FigureEditorKind.Unsupported AndAlso Editor = editorKind
    End Function

    Friend ReadOnly Property ReadOnlyMessage As String
        Get
            If IsBottomHalf Then Return "This is the Swapper bottom half. Attach the top and read it in Skylanders to edit Gold and Level."
            Dim tab As String = Nothing
            Select Case Editor
                Case FigureEditorKind.Skylanders : tab = "Skylanders"
                Case FigureEditorKind.Vehicles : tab = "Vehicles"
                Case FigureEditorKind.Crystals : tab = "Imaginators / CYOS"
                Case FigureEditorKind.Traps : tab = "Traps"
            End Select
            If tab IsNot Nothing Then Return "This figure can be edited in the " & tab & " tab."
            Return "This figure is preview-only here. No supported editor was found."
        End Get
    End Property

    Friend Shared Function IsTopId(id As Integer) As Boolean
        Return (id >= 2000 AndAlso id <= 2015) OrElse id = 2999
    End Function

    Friend Shared Function IsBottomId(id As Integer) As Boolean
        Return (id >= 1000 AndAlso id <= 1015) OrElse id = 1999
    End Function

